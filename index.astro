---
import Base from '../../layouts/Base.astro';
export function getStaticPaths(){return ['en','id','ta'].map(lang=>({params:{lang}}))}
const lang=Astro.params.lang||'en';
const t={en:{title:'Connecting the Tamil Community in Indonesia',desc:'A shared space to celebrate Tamil language and culture, bring generations together, and strengthen community connections across Indonesia.',eyebrow:'LANGUAGE · HERITAGE · COMMUNITY',about:'A shared home for our community',events:'Events & programmes',culture:'Tamil language & culture',news:'News & announcements',join:'Take part in the community',aboutText:'Discover the Sangam, its people and the activities that bring our community together.',eventsText:'Find confirmed upcoming events, cultural programmes and community gatherings.',cultureText:'Explore educational resources, literature, arts and traditions.',newsText:'Read official updates and community announcements.',action:'Explore events',aboutAction:'About the Sangam',joinAction:'Register your interest',notice:'Official history, committee listings and event details will be published after verification.'},id:{title:'Menghubungkan Komunitas Tamil di Indonesia',desc:'Ruang bersama untuk merayakan bahasa dan budaya Tamil, mempertemukan generasi, dan memperkuat hubungan komunitas di seluruh Indonesia.',eyebrow:'BAHASA · WARISAN · KOMUNITAS',about:'Ruang bersama bagi komunitas',events:'Acara & program',culture:'Bahasa & budaya Tamil',news:'Berita & pengumuman',join:'Berpartisipasi dalam komunitas',aboutText:'Kenali Sangam dan kegiatan yang mempertemukan komunitas.',eventsText:'Temukan acara terkonfirmasi dan program budaya.',cultureText:'Jelajahi sumber pembelajaran, sastra, seni, dan tradisi.',newsText:'Baca informasi resmi dan pengumuman komunitas.',action:'Lihat acara',aboutAction:'Tentang Sangam',joinAction:'Daftarkan minat',notice:'Sejarah resmi, daftar pengurus, dan informasi acara akan diterbitkan setelah dikonfirmasi.'},ta:{title:'இந்தோனேசியத் தமிழ் சமூகத்தை இணைப்போம்',desc:'தமிழ் மொழி மற்றும் பண்பாட்டைக் கொண்டாடவும், தலைமுறைகளை இணைக்கவும், இந்தோனேசியா முழுவதும் சமூக உறவுகளை வலுப்படுத்தவும் ஒரு பொதுத் தளம்.',eyebrow:'மொழி · மரபு · சமூகம்',about:'நமது சமூகத்திற்கான பொதுத் தளம்',events:'நிகழ்வுகள் மற்றும் நிகழ்ச்சிகள்',culture:'தமிழ் மொழி மற்றும் பண்பாடு',news:'செய்திகள் மற்றும் அறிவிப்புகள்',join:'சமூகத்தில் பங்கேற்கவும்',aboutText:'சங்கம் மற்றும் சமூகத்தை ஒன்றிணைக்கும் செயல்பாடுகளை அறியுங்கள்.',eventsText:'உறுதிப்படுத்தப்பட்ட நிகழ்வுகள் மற்றும் பண்பாட்டு நிகழ்ச்சிகளைக் காணுங்கள்.',cultureText:'கல்வி வளங்கள், இலக்கியம், கலைகள் மற்றும் மரபுகளை அறியுங்கள்.',newsText:'அதிகாரப்பூர்வ புதுப்பிப்புகளைப் படியுங்கள்.',action:'நிகழ்வுகளைக் காண்க',aboutAction:'சங்கத்தைப் பற்றி',joinAction:'விருப்பத்தைப் பதிவு செய்க',notice:'அதிகாரப்பூர்வ வரலாறு, நிர்வாகப் பட்டியல் மற்றும் நிகழ்வு விவரங்கள் உறுதிப்படுத்தப்பட்ட பிறகு வெளியிடப்படும்.'}}[lang];
---
<Base title={t.title} description={t.desc} lang={lang} active="home">
<section class="hero"><div class="shell hero-inner"><div class="eyebrow">{t.eyebrow}</div><h1>{t.title}</h1><p>{t.desc}</p><div class="actions"><a class="button" href={`/${lang}/events/`}>{t.action} →</a><a class="button secondary" href={`/${lang}/about/`}>{t.aboutAction}</a></div></div></section>
<section class="section"><div class="shell"><div class="section-head"><div class="eyebrow">{lang==='ta'?'எங்களைப் பற்றி':lang==='id'?'Tentang kami':'About us'}</div><h2>{t.about}</h2><p>{t.aboutText}</p></div><div class="grid"><article class="card"><div class="symbol" aria-hidden="true">◈</div><h3>{t.events}</h3><p>{t.eventsText}</p><a href={`/${lang}/events/`}>{t.action} →</a></article><article class="card"><div class="symbol" aria-hidden="true">文</div><h3>{t.culture}</h3><p>{t.cultureText}</p><a href={`/${lang}/culture/`}>{lang==='ta'?'மேலும் அறிக':lang==='id'?'Pelajari lebih lanjut':'Explore culture'} →</a></article><article class="card"><div class="symbol" aria-hidden="true">✦</div><h3>{t.news}</h3><p>{t.newsText}</p><a href={`/${lang}/news/`}>{lang==='ta'?'அனைத்து அறிவிப்புகள்':lang==='id'?'Semua berita':'All announcements'} →</a></article></div></div></section>
<section class="section soft"><div class="shell two-col"><div><div class="eyebrow">{lang==='ta'?'பங்கேற்கவும்':lang==='id'?'Mari berpartisipasi':'Get involved'}</div><h2>{t.join}</h2><p class="lead">{t.aboutText}</p><a class="button dark" href={`/${lang}/contact/`}>{t.joinAction} →</a></div><div class="notice">{t.notice}</div></div></section>
</Base>
