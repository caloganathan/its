---
import Base from '../../layouts/Base.astro';
const pages=import.meta.glob('../../content/pages/**/*.md',{eager:true});
export function getStaticPaths(){const all=import.meta.glob('../../content/pages/**/*.md',{eager:true});return Object.keys(all).filter(k=>!k.endsWith('/home.md')).map(k=>{const m=k.match(/\/pages\/(en|id|ta)\/(.+)\.md$/);return {params:{lang:m[1],slug:m[2]},props:{page:all[k]}}})}
const {page}=Astro.props;const lang=Astro.params.lang||'en';const meta=page.frontmatter;const Content=page.default;const slug=Astro.params.slug||'';
---
<Base title={meta.title} description={meta.description} lang={lang} active={slug.split('/')[0]}>
<header class="page-hero"><div class="shell"><div class="breadcrumb"><a href={`/${lang}/`}>{lang==='id'?'Beranda':lang==='ta'?'முகப்பு':'Home'}</a> / {meta.title}</div><div class="eyebrow">{meta.eyebrow||'Indonesia Tamil Sangam'}</div><h1>{meta.title}</h1><p>{meta.description}</p></div></header>
<section class="section"><div class="shell prose"><Content /></div></section>
{(slug==='contact' || slug==='join') && <section class="section soft"><div class="shell"><div class="section-head"><h2>{lang==='id'?'Formulir pendaftaran dan pertanyaan':lang==='ta'?'பதிவு மற்றும் விசாரணை படிவம்':'Registration & enquiry form'}</h2><p>{lang==='id'?'Formulir ini membuka aplikasi email Anda; data tidak disimpan di situs ini.':lang==='ta'?'படிவம் உங்கள் மின்னஞ்சல் செயலியைத் திறக்கும்; விவரங்கள் இணையதளத்தில் சேமிக்கப்படாது.':'This form opens your email application; information is not stored on this website.'}</p></div>
<form id="interest-form" class="form-grid" data-email="indonesiatamilsangaminfo@gmail.com"><div class="field"><label for="name">{lang==='id'?'Nama lengkap':lang==='ta'?'முழுப் பெயர்':'Full name'} *</label><input id="name" name="name" autocomplete="name" required maxlength="120" /></div><div class="field"><label for="email">Email *</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="160" /></div><div class="field"><label for="city">{lang==='id'?'Kota tempat tinggal':lang==='ta'?'வசிக்கும் நகரம்':'City of residence'}</label><input id="city" name="city" maxlength="100" /></div><div class="field"><label for="interest">{lang==='id'?'Jenis minat':lang==='ta'?'விருப்பத்தின் வகை':'Area of interest'} *</label><select id="interest" name="interest" required><option value="">Select an option</option><option>Membership enquiry</option><option>Volunteering</option><option>Events and programmes</option><option>Cultural collaboration</option><option>Other enquiry</option></select></div><div class="field full"><label for="message">{lang==='id'?'Pesan (tanpa informasi sensitif)':lang==='ta'?'செய்தி (முக்கியமான தனிப்பட்ட தகவல்களைச் சேர்க்க வேண்டாம்)':'Message (do not include sensitive personal information)'}</label><textarea id="message" name="message" maxlength="1500"></textarea></div><div class="field full"><label><input type="checkbox" name="consent" required style="width:auto;margin-right:.45rem" />{lang==='id'?'Saya setuju informasi ini digunakan untuk menanggapi pertanyaan saya.':lang==='ta'?'எனது விசாரணைக்குப் பதிலளிக்க இந்தத் தகவலைப் பயன்படுத்த ஒப்புக்கொள்கிறேன்.':'I consent to this information being used to respond to my enquiry.'} *</label></div><div class="field full"><button class="button dark" type="submit">{lang==='id'?'Buat email':lang==='ta'?'மின்னஞ்சலைத் தயார் செய்க':'Prepare email'} →</button><p class="fineprint">This prototype does not transmit or store form data. An email application is required; review the draft before sending.</p><div id="form-status" role="status" aria-live="polite"></div></div></form>
<script is:inline>document.getElementById('interest-form')?.addEventListener('submit',function(e){e.preventDefault();if(!this.reportValidity())return;const fd=new FormData(this);const subject=encodeURIComponent('Indonesia Tamil Sangam — website enquiry');const lines=['Website enquiry','',`Name: ${fd.get('name')}`,`Email: ${fd.get('email')}`,`City: ${fd.get('city')||'Not provided'}`,`Interest: ${fd.get('interest')}`,`Message: ${fd.get('message')||'Not provided'}`,'','Consent: Yes'];document.getElementById('form-status').textContent='Your email application should open with a draft. Please review it and send it yourself.';window.location.href=`mailto:${this.dataset.email}?subject=${subject}&body=${encodeURIComponent(lines.join('\n'))}`;});</script></div></section>}
</Base>
