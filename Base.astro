---
const { title, description, lang = 'en', active = 'home' } = Astro.props;
const root = `/${lang}`;
const nav = {
 en: [{id:'home',label:'Home',href:`${root}/`},{id:'about',label:'About Us',href:`${root}/about/`},{id:'events',label:'Events',href:`${root}/events/`},{id:'culture',label:'Tamil Culture',href:`${root}/culture/`},{id:'news',label:'News',href:`${root}/news/`},{id:'gallery',label:'Gallery',href:`${root}/gallery/`},{id:'resources',label:'Resources',href:`${root}/resources/`},{id:'contact',label:'Contact',href:`${root}/contact/`}],
 id: [{id:'home',label:'Beranda',href:`${root}/`},{id:'about',label:'Tentang Kami',href:`${root}/about/`},{id:'events',label:'Acara',href:`${root}/events/`},{id:'culture',label:'Budaya Tamil',href:`${root}/culture/`},{id:'news',label:'Berita',href:`${root}/news/`},{id:'gallery',label:'Galeri',href:`${root}/gallery/`},{id:'resources',label:'Sumber Daya',href:`${root}/resources/`},{id:'contact',label:'Kontak',href:`${root}/contact/`}],
 ta: [{id:'home',label:'முகப்பு',href:`${root}/`},{id:'about',label:'எங்களைப் பற்றி',href:`${root}/about/`},{id:'events',label:'நிகழ்வுகள்',href:`${root}/events/`},{id:'culture',label:'தமிழ் பண்பாடு',href:`${root}/culture/`},{id:'news',label:'செய்திகள்',href:`${root}/news/`},{id:'gallery',label:'படத்தொகுப்பு',href:`${root}/gallery/`},{id:'resources',label:'வளங்கள்',href:`${root}/resources/`},{id:'contact',label:'தொடர்பு',href:`${root}/contact/`}]
};
const labels = {en:{tagline:'Language. Heritage. Community.',join:'Register your interest',footer:'An inclusive home for Tamil language, culture and community in Indonesia.',quick:'Quick links',notice:'Official details are being reviewed by the Sangam committee.'},id:{tagline:'Bahasa. Warisan. Komunitas.',join:'Daftarkan minat Anda',footer:'Ruang bersama untuk bahasa, budaya, dan komunitas Tamil di Indonesia.',quick:'Tautan cepat',notice:'Informasi resmi sedang ditinjau oleh pengurus Sangam.'},ta:{tagline:'மொழி. மரபு. சமூகம்.',join:'உங்கள் விருப்பத்தைப் பதிவு செய்யுங்கள்',footer:'இந்தோனேசியாவில் தமிழ் மொழி, பண்பாடு மற்றும் சமூகத்திற்கான பொதுத் தளம்.',quick:'விரைவு இணைப்புகள்',notice:'அதிகாரப்பூர்வ விவரங்கள் சங்கக் குழுவால் பரிசீலிக்கப்படுகின்றன.'}};
const l = labels[lang] || labels.en;
const langs = [{code:'en',label:'EN'},{code:'id',label:'ID'},{code:'ta',label:'தமிழ்'}];
const path = Astro.url.pathname.replace(/^\/(en|id|ta)/, '') || '/';
const canonical = `https://indonesiatamilsangam.com${Astro.url.pathname}`;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Indonesia Tamil Sangam</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#12365a" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Indonesia Tamil Sangam" />
  <meta property="og:title" content={`${title} | Indonesia Tamil Sangam`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://indonesiatamilsangam.com/images/indonesia-tamil-sangam-logo.png" />
  <link rel="alternate" hreflang="en" href={`https://indonesiatamilsangam.com/en${path === '/' ? '/' : path}`} />
  <link rel="alternate" hreflang="id" href={`https://indonesiatamilsangam.com/id${path === '/' ? '/' : path}`} />
  <link rel="alternate" hreflang="ta" href={`https://indonesiatamilsangam.com/ta${path === '/' ? '/' : path}`} />
  <link rel="alternate" hreflang="x-default" href="https://indonesiatamilsangam.com/en/" />
  <link rel="icon" type="image/png" href="/images/indonesia-tamil-sangam-logo.png" />
  <style is:global>
    :root{--navy:#12365a;--navy2:#0b2744;--gold:#c9a45b;--cream:#f7f4ed;--paper:#fffdf8;--ink:#172332;--muted:#5d6875;--line:#e4e0d6;--max:1160px;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:var(--paper);font-synthesis:none;text-rendering:optimizeLegibility}*{box-sizing:border-box}body{margin:0;line-height:1.65}a{color:var(--navy);text-underline-offset:3px}a:hover{color:#8a6726}img{max-width:100%;height:auto}button,input,select,textarea{font:inherit}.skip{position:absolute;left:-9999px;top:0;background:white;padding:.75rem;z-index:99}.skip:focus{left:1rem}.shell{max-width:var(--max);margin:auto;padding-inline:clamp(1rem,4vw,2.5rem)}.topline{background:var(--navy2);color:#f7f4ed;font-size:.83rem}.topline .shell{display:flex;justify-content:space-between;gap:1rem;padding-block:.45rem}.topline a{color:#fff}.site-header{background:var(--paper);border-bottom:1px solid var(--line)}.header-inner{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;padding-block:1rem}.brand{display:flex;align-items:center;gap:.8rem;text-decoration:none;color:var(--navy);min-width:210px}.brand img{width:62px;height:62px;object-fit:contain}.brand strong{display:block;font-size:1rem;line-height:1.25;letter-spacing:.025em}.brand small{display:block;color:var(--muted);font-size:.78rem;margin-top:.15rem}.nav{display:flex;flex-wrap:wrap;gap:.15rem;justify-content:flex-end;align-items:center}.nav a{padding:.5rem .62rem;text-decoration:none;font-size:.88rem;font-weight:650;border-radius:5px}.nav a[aria-current=page],.nav a:hover{background:var(--cream);color:var(--navy2)}.language{display:flex;gap:.3rem;white-space:nowrap}.language a{font-size:.76rem;padding:.25rem .4rem;border:1px solid var(--line);border-radius:4px;text-decoration:none}.hero{background:var(--navy);color:#fff;position:relative;overflow:hidden}.hero:after{content:"";position:absolute;width:340px;height:340px;border:1px solid #ffffff20;border-radius:50%;right:-80px;top:-140px;box-shadow:0 0 0 36px #ffffff08,0 0 0 72px #ffffff05}.hero-inner{position:relative;z-index:1;padding-block:clamp(3.5rem,9vw,7.2rem);max-width:850px}.eyebrow{text-transform:uppercase;letter-spacing:.15em;font-size:.76rem;font-weight:750;color:var(--gold)}h1,h2,h3{line-height:1.18;color:var(--navy);letter-spacing:-.025em}h1{font-size:clamp(2.35rem,6vw,4.8rem);margin:.8rem 0 1rem}h2{font-size:clamp(1.6rem,3vw,2.35rem);margin:0 0 1rem}h3{font-size:1.22rem;margin:.2rem 0 .65rem}.hero h1{color:#fff;max-width:850px}.hero p{font-size:clamp(1.05rem,2vw,1.25rem);color:#e9eef4;max-width:680px}.hero .eyebrow{color:#e4c987}.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.6rem}.button{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;background:var(--gold);color:#16283a;border:1px solid var(--gold);border-radius:5px;padding:.78rem 1.1rem;font-weight:750;text-decoration:none;cursor:pointer}.button:hover{background:#e0bd76;color:#16283a}.button.secondary{background:transparent;color:#fff;border-color:#ffffff80}.button.dark{background:var(--navy);border-color:var(--navy);color:white}.section{padding-block:clamp(3rem,6vw,5.2rem)}.section.soft{background:var(--cream)}.section-head{max-width:720px;margin-bottom:2rem}.section-head p,.lead{font-size:1.1rem;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.card{border:1px solid var(--line);border-radius:9px;padding:1.35rem;background:#fff;min-width:0}.card p{color:var(--muted);margin:.2rem 0 1rem}.card a{font-weight:700}.card .symbol{display:inline-grid;place-items:center;background:var(--cream);color:var(--navy);width:42px;height:42px;border-radius:50%;font-size:1.2rem;margin-bottom:.8rem}.two-col{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(2rem,6vw,5rem);align-items:start}.notice{border-left:4px solid var(--gold);padding:1rem 1.2rem;background:var(--cream);color:#384453}.page-hero{background:var(--cream);padding-block:3.2rem}.page-hero h1{font-size:clamp(2.2rem,5vw,3.5rem);margin:.5rem 0}.page-hero p{max-width:780px;color:var(--muted);font-size:1.1rem}.prose{max-width:820px}.prose p,.prose li{font-size:1.03rem}.prose h2{margin-top:2rem}.prose h3{margin-top:1.4rem}.empty-state{padding:1.5rem;border:1px dashed #bdb6a7;background:#fffdf8;border-radius:8px}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.field{display:flex;flex-direction:column;gap:.35rem}.field.full{grid-column:1/-1}.field label{font-weight:700;font-size:.92rem}.field input,.field select,.field textarea{border:1px solid #b8c0c8;border-radius:5px;padding:.75rem;background:white;color:var(--ink);width:100%}.field textarea{min-height:120px}.field input:focus,.field select:focus,.field textarea:focus{outline:3px solid #c9a45b55;border-color:var(--navy)}.fineprint{font-size:.85rem;color:var(--muted)}.site-footer{background:var(--navy2);color:#e7edf3;padding-block:3rem 1.5rem}.site-footer h2,.site-footer h3{color:white}.footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:2rem}.site-footer a{color:#f2dca8}.site-footer ul{padding-left:1.1rem}.copyright{border-top:1px solid #ffffff26;margin-top:2rem;padding-top:1rem;font-size:.83rem;color:#c5d0da;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}.pill{display:inline-block;padding:.2rem .55rem;border-radius:999px;background:#e8e1d1;color:#344050;font-size:.76rem;font-weight:750}.breadcrumb{font-size:.85rem;color:var(--muted)}.breadcrumb a{color:inherit}.mobile-menu{display:none}.status{margin-top:1rem;padding:.8rem;background:#eef5ef;border:1px solid #c6dec9;border-radius:5px}.muted{color:var(--muted)}@media(max-width:900px){.header-inner{align-items:flex-start;flex-wrap:wrap}.nav{order:3;justify-content:flex-start;width:100%;border-top:1px solid var(--line);padding-top:.65rem}.nav a{padding:.45rem .5rem}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.two-col{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr 1fr}}@media(max-width:580px){.topline .shell{font-size:.75rem}.header-inner{gap:.8rem}.brand img{width:50px;height:50px}.brand strong{font-size:.9rem}.brand small{font-size:.72rem}.nav{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.2rem}.nav a{text-align:center;font-size:.76rem;padding:.5rem .15rem}.language{margin-left:auto}.grid,.footer-grid,.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.hero-inner{padding-block:3.3rem}.copyright{display:block}.copyright span{display:block;margin-top:.35rem}}
  </style>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org','@type':'Organization',name:'Indonesia Tamil Sangam',alternateName:'Paguyuban Indonesia Tamil Sangam',url:'https://indonesiatamilsangam.com',logo:'https://indonesiatamilsangam.com/images/indonesia-tamil-sangam-logo.png',email:'indonesiatamilsangaminfo@gmail.com',telephone:'085195548554',address:{'@type':'PostalAddress',streetAddress:'Citra Tower Kemayoran Lt 3, Unit H1 Kavling A6, Jl. Benyamin Sueb, Kebon Kosong, Kemayoran',addressLocality:'Jakarta Pusat',addressRegion:'DKI Jakarta',postalCode:'10630',addressCountry:'ID'},sameAs:[]})} />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="topline"><div class="shell"><span>{l.tagline}</span><span><a href="mailto:indonesiatamilsangaminfo@gmail.com">Contact the Sangam</a></span></div></div>
<header class="site-header"><div class="shell header-inner">
<a class="brand" href={`/${lang}/`} aria-label="Indonesia Tamil Sangam home"><img src="/images/indonesia-tamil-sangam-logo.png" alt="Indonesia Tamil Sangam logo" width="62" height="62"/><span><strong>INDONESIA TAMIL SANGAM</strong><small>{lang==='ta'?'இந்தோனேசியா தமிழ் சங்கம்':lang==='id'?'Paguyuban Indonesia Tamil Sangam':'தமிழ் • Indonesia'}</small></span></a>
<nav class="nav" aria-label="Main navigation">{nav[lang].map(item=><a href={item.href} aria-current={active===item.id?'page':undefined}>{item.label}</a>)}</nav>
<div class="language" aria-label="Choose language">{langs.map(x=><a href={`/${x.code}${path==='/'?'/':path}`} lang={x.code} aria-label={x.label}>{x.label}</a>)}</div>
</div></header>
<main id="main"><slot /></main>
<footer class="site-footer"><div class="shell"><div class="footer-grid"><div><a class="brand" href={`/${lang}/`}><img src="/images/indonesia-tamil-sangam-logo.png" alt="" width="62" height="62"/><span><strong style="color:white">INDONESIA TAMIL SANGAM</strong><small style="color:#c5d0da">{l.tagline}</small></span></a><p>{l.footer}</p><p class="fineprint">{l.notice}</p></div><div><h3>{l.quick}</h3><ul>{nav[lang].slice(1).map(item=><li><a href={item.href}>{item.label}</a></li>)}</ul></div><div><h3>{lang==='id'?'Hubungi Kami':lang==='ta'?'எங்களைத் தொடர்புகொள்ள':'Contact'}</h3><p><a href="mailto:indonesiatamilsangaminfo@gmail.com">indonesiatamilsangaminfo@gmail.com</a></p><p><a href="tel:085195548554">085195548554</a></p><p>Citra Tower Kemayoran, Level 3, Unit H1, Jakarta Pusat 10630, Indonesia</p><p><a href={`/${lang}/contact/`}>{lang==='id'?'Formulir pendaftaran dan pertanyaan':lang==='ta'?'பதிவு மற்றும் விசாரணை':'Registration & enquiries'}</a></p></div></div><div class="copyright"><span>© {new Date().getFullYear()} Indonesia Tamil Sangam. All rights reserved.</span><span><a href={`/${lang}/privacy/`}>{lang==='id'?'Kebijakan Privasi':lang==='ta'?'தனியுரிமைக் கொள்கை':'Privacy Policy'}</a> · <a href={`/${lang}/media/`}>Media & Press</a></span></div></div></footer>
</body></html>
