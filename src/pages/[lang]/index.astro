---
import Base from '../../layouts/Base.astro';
import Kolam from '../../components/Kolam.astro';
import Seal from '../../components/Seal.astro';
import EventCard from '../../components/EventCard.astro';
import FeaturedEvent from '../../components/FeaturedEvent.astro';
import { SITE, LANGS, type Lang } from '../../site';
import { useT } from '../../i18n/ui';
import { getEvents } from '../../lib/events';

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const events = await getEvents(lang);
const upcoming = events.filter((e) => e.upcoming);
const featured = upcoming.find((e) => e.data.featured) ?? upcoming[0];
const strip = (upcoming.length ? upcoming.filter((e) => e !== featured) : events).slice(0, 3);
const pillars = [1, 2, 3] as const;
const explore = [
  { id: 'culture', n: 'I' }, { id: 'news', n: 'II' }, { id: 'gallery', n: 'III' }, { id: 'resources', n: 'IV' },
] as const;
---
<Base title={t('home.title')} description={t('home.desc')} lang={lang} active="home" home>
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <Kolam class="hero-kolam" animate />
    <div class="shell hero-inner">
      <Seal size={132} class="hero-seal" alt={`${SITE.name} emblem`} priority />
      <p class="tamil" lang="ta">{SITE.nameTa}</p>
      <h1>{t('home.title')}</h1>
      <p class="sub">{t('home.desc')}</p>
      <div class="actions">
        <a class="btn" href={`/${lang}/events/`}>{t('home.cta.events')} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn ghost" href={`/${lang}/join/`}>{t('home.cta.join')}</a>
      </div>
    </div>
    <a class="hero-scroll" href="#pillars" aria-label={t('home.scroll')}><span></span></a>
  </section>

  <section class="section" id="pillars">
    <div class="shell">
      <div class="section-head" data-reveal>
        <div><p class="eyebrow">{t('home.pillars.eyebrow')}</p><h2>{t('home.pillars.title')}</h2></div>
      </div>
      <ol class="pillars">
        {pillars.map((i) => (
          <li data-reveal style={`--d:${i * 0.12}s`}>
            <span class="num">0{i}</span>
            <h3>{t(`home.p${i}.title`)}</h3>
            <p>{t(`home.p${i}.text`)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="quote section ivory" aria-label="Purananuru 192">
    <Kolam class="quote-kolam" />
    <figure class="shell" data-reveal>
      <blockquote>
        {lang !== 'ta' && <p class="ta-line" lang="ta">யாதும் ஊரே; யாவரும் கேளிர்.</p>}
        <p class="q">{t('home.quote.text')}</p>
      </blockquote>
      <figcaption>— {t('home.quote.source')}</figcaption>
    </figure>
  </section>

  {featured && <FeaturedEvent event={featured} lang={lang} />}

  {(strip.length > 0 || !featured) && <section class="section ivory">
    <div class="shell">
      <div class="section-head" data-reveal>
        <div><p class="eyebrow">{t('home.events.eyebrow')}</p><h2>{t('home.events.title')}</h2></div>
        <a class="link-arrow" href={`/${lang}/events/`}>{t('home.events.all')} <span aria-hidden="true">→</span></a>
      </div>
      {strip.length > 0 ? (
        <div class="ev-grid">{strip.map((e, i) => <div data-reveal style={`--d:${i * 0.1}s`}><EventCard event={e} lang={lang} /></div>)}</div>
      ) : !featured && (
        <div class="empty" data-reveal>
          <Kolam class="empty-kolam" />
          <div><h3>{t('events.none.title')}</h3><p>{t('events.none.text')}</p>
          <a class="btn dark" href={`/${lang}/join/`}>{t('events.none.cta')} <span class="arrow" aria-hidden="true">→</span></a></div>
        </div>
      )}
    </div>
  </section>}

  <section class="section">
    <div class="shell">
      <div class="section-head" data-reveal><div><p class="eyebrow">{t('home.explore.eyebrow')}</p><h2>{t('home.explore.title')}</h2></div></div>
      <div class="explore">
        {explore.map((x, i) => (
          <a class="card tile" href={`/${lang}/${x.id}/`} data-reveal style={`--d:${i * 0.08}s`}>
            <span class="roman">{x.n}</span>
            <h3>{t(`nav.${x.id}`)}</h3>
            <p>{t(`home.explore.${x.id}`)}</p>
            <span class="go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="join">
    <div class="shell join-inner" data-reveal>
      <div><h2>{t('home.join.title')}</h2><p>{t('home.join.text')}</p></div>
      <a class="btn dark" href={`/${lang}/join/`}>{t('home.join.cta')} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; min-height: 100svh; display: grid; place-items: center; text-align: center; color: #fff; background: radial-gradient(120% 90% at 50% 0%, #143c66 0%, #0a2441 45%, var(--ink) 100%); padding: 8rem 0 6rem; }
  .glow { position: absolute; inset: auto 0 -30% 0; height: 70%; background: radial-gradient(50% 60% at 50% 100%, rgba(201,164,91,.28), transparent 70%); z-index: -1; animation: breathe 9s ease-in-out infinite alternate; }
  .hero :global(.hero-kolam) { position: absolute; z-index: -1; width: min(980px, 140vw); left: 50%; top: 50%; translate: -50% -50%; opacity: .18; animation: spin 240s linear infinite; }
  .hero-inner { display: flex; flex-direction: column; align-items: center; }
  .hero-inner :global(.hero-seal) { margin-bottom: 1.8rem; animation: fade-up 1.2s .1s var(--ease) both; }
  @media (max-width: 600px) { .hero-inner :global(.hero-seal) { --s: 104px !important; } }
  .tamil { font-family: 'Noto Serif Tamil Variable', serif; color: var(--gold-2); font-size: clamp(1rem, 1.8vw, 1.3rem); letter-spacing: .04em; margin-bottom: 1rem; animation: fade-up 1.2s .3s var(--ease) both; }
  h1 { color: #fff; max-width: 15ch; font-weight: 400; margin-bottom: .45em; animation: fade-up 1.4s .45s var(--ease) both; }
  :lang(ta) h1 { max-width: 20ch; }
  .sub { max-width: 54ch; color: var(--on-dark-muted); font-size: clamp(1.05rem, 1.6vw, 1.25rem); animation: fade-up 1.4s .65s var(--ease) both; }
  .actions { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center; margin-top: 1.6rem; animation: fade-up 1.4s .85s var(--ease) both; }
  .hero-scroll { position: absolute; bottom: 2rem; left: 50%; translate: -50% 0; width: 26px; height: 42px; border: 1px solid rgba(255,255,255,.4); border-radius: 999px; }
  .hero-scroll span { position: absolute; left: 50%; top: 8px; width: 2px; height: 8px; margin-left: -1px; background: var(--gold-2); border-radius: 2px; animation: scrolldot 2.2s ease-in-out infinite; }

  .pillars { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); counter-reset: p; }
  .pillars li { border-top: 1px solid var(--line); padding-top: 1.75rem; }
  .num { display: block; font-family: var(--f-display); font-size: .95rem; color: var(--gold); margin-bottom: 1.4rem; letter-spacing: .1em; }
  .pillars h3 { font-size: clamp(1.8rem, 2.6vw, 2.3rem); }
  .pillars p { color: var(--muted); }

  .quote { text-align: center; overflow: hidden; isolation: isolate; }
  .quote :global(.quote-kolam) { position: absolute; width: 560px; left: 50%; top: 50%; translate: -50% -50%; opacity: .22; z-index: -1; }
  .quote blockquote { margin: 0 auto; max-width: 900px; }
  .ta-line { font-family: 'Noto Serif Tamil Variable', serif; color: #9a7633; font-size: clamp(1.2rem, 2.2vw, 1.6rem); margin-bottom: 1.25rem; }
  .q { font-family: var(--f-display); font-weight: 300; font-style: italic; font-size: clamp(1.9rem, 4.4vw, 3.6rem); line-height: 1.2; color: var(--navy); }
  :lang(ta) .q { font-style: normal; font-weight: 500; }
  figcaption { font-size: .8rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
  :lang(ta) figcaption { letter-spacing: .04em; }

  .ev-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .empty { display: grid; grid-template-columns: 220px 1fr; gap: 2.5rem; align-items: center; padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid var(--line); border-radius: calc(var(--radius) + 6px); background: var(--paper); }
  .empty :global(.empty-kolam) { width: 100%; opacity: .7; }
  .empty p { color: var(--muted); max-width: 56ch; }

  .explore { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; }
  .tile { display: flex; flex-direction: column; padding: 2rem 1.6rem 1.6rem; min-height: 280px; text-decoration: none; color: var(--text); }
  .roman { font-family: var(--f-display); color: var(--gold); font-size: 1rem; margin-bottom: auto; }
  .tile h3 { margin-top: 3rem; }
  .tile p { color: var(--muted); font-size: .95rem; margin-bottom: 1rem; }
  .go { align-self: flex-end; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--line); color: var(--navy); transition: background .4s var(--ease), color .4s, transform .4s var(--ease); }
  .tile:hover .go { background: var(--navy); color: #fff; transform: translateX(4px); }

  .join { background: linear-gradient(120deg, #d9b977, var(--gold) 55%, #b48d44); padding-block: clamp(3.5rem, 7vw, 5.5rem); }
  .join-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2rem; }
  .join h2 { color: var(--ink); margin-bottom: .3em; }
  .join p { color: #2b2a24; max-width: 56ch; margin: 0; }

  @media (max-width: 900px) {
    .pillars, .ev-grid { grid-template-columns: 1fr; }
    .explore { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .empty { grid-template-columns: 1fr; } .empty :global(.empty-kolam) { width: 140px; }
  }
  @media (max-width: 520px) { .explore { grid-template-columns: 1fr; } .tile { min-height: 0; } .tile h3 { margin-top: 1.5rem; } }

  @keyframes fade-up { from { opacity: 0; transform: translateY(24px); } }
  @keyframes spin { to { rotate: 360deg; } }
  @keyframes breathe { to { opacity: .55; transform: scale(1.1); } }
  @keyframes scrolldot { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(14px); } }
</style>
