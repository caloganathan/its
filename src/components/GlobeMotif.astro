---
// Hero stage: a shaded wireframe globe that turns slowly, with the Thiruvalluvar line drawing
// floating at its centre as a layered 3D figure (depth layers + slow yaw + pointer parallax).
// Decorative only (aria-hidden). Image: public/images/thiruvalluvar-line.webp (committee-supplied sketch).
const { class: cls = '' } = Astro.props;
const R = 190, C = 200;
const MERIDIANS = 6;
const parallels = [0, 30, 60].flatMap((deg) => {
  const dy = R * Math.sin((deg * Math.PI) / 180), hw = R * Math.cos((deg * Math.PI) / 180);
  return deg === 0 ? [{ y: C, hw }] : [{ y: C - dy, hw }, { y: C + dy, hw }];
});
const IMG = '/images/thiruvalluvar-line.webp';
---
<div class:list={['stage', cls]} aria-hidden="true" data-stage>
  <svg class="globe" viewBox="0 0 400 400" fill="none" focusable="false">
    <defs>
      <radialGradient id="g-body" cx="36%" cy="30%" r="80%">
        <stop offset="0" stop-color="oklch(0.62 0.13 270)" stop-opacity=".55" />
        <stop offset=".55" stop-color="oklch(0.35 0.12 272)" stop-opacity=".35" />
        <stop offset="1" stop-color="oklch(0.2 0.1 272)" stop-opacity=".55" />
      </radialGradient>
      <radialGradient id="g-halo" cx="50%" cy="50%" r="50%">
        <stop offset=".7" stop-color="oklch(0.76 0.08 267)" stop-opacity=".25" /><stop offset="1" stop-color="oklch(0.76 0.08 267)" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="g-spec" cx="30%" cy="22%" r="30%">
        <stop offset="0" stop-color="#fff" stop-opacity=".35" /><stop offset="1" stop-color="#fff" stop-opacity="0" />
      </radialGradient>
    </defs>
    <circle cx={C} cy={C} r={R + 14} fill="url(#g-halo)" />
    <circle cx={C} cy={C} r={R} fill="url(#g-body)" />
    <g stroke="currentColor" stroke-width=".9" stroke-linecap="round">
      <circle cx={C} cy={C} r={R} stroke-width="1.5" />
      {Array.from({ length: MERIDIANS }, (_, k) => <ellipse class="meridian" cx={C} cy={C} rx={R} ry={R} style={`animation-delay:-${(k / MERIDIANS) * 72}s`} />)}
      {parallels.map((p) => <line x1={C - p.hw} y1={p.y} x2={C + p.hw} y2={p.y} />)}
    </g>
    <circle cx={C} cy={C} r={R} fill="url(#g-spec)" />
  </svg>
  <div class="fig" data-fig>
    <img class="layer l-glow" src={IMG} alt="" width="860" height="852" loading="eager" decoding="async" />
    <img class="layer l-back" src={IMG} alt="" width="860" height="852" loading="eager" decoding="async" />
    <img class="layer l-main" src={IMG} alt="" width="860" height="852" loading="eager" decoding="async" fetchpriority="high" />
    <img class="layer l-front" src={IMG} alt="" width="860" height="852" loading="eager" decoding="async" />
  </div>
</div>
<script is:inline>
  (() => {
    const s = document.querySelector('[data-stage]'); if (!s) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !matchMedia('(hover: hover)').matches) return;
    let raf = 0; const set = (x, y) => { s.style.setProperty('--px', x.toFixed(3)); s.style.setProperty('--py', y.toFixed(3)); };
    addEventListener('pointermove', (e) => { cancelAnimationFrame(raf); raf = requestAnimationFrame(() => set(e.clientX / innerWidth - .5, e.clientY / innerHeight - .5)); }, { passive: true });
  })();
</script>
<style>
  .stage { --px: 0; --py: 0; position: relative; aspect-ratio: 1; width: 100%; perspective: 1400px; color: var(--gold-2); }
  .globe { position: absolute; inset: -4%; width: 108%; height: 108%; overflow: visible; filter: drop-shadow(0 40px 60px color-mix(in oklch, var(--navy-2) 80%, transparent)); }
  .meridian { transform-box: fill-box; transform-origin: center; animation: meridian-turn 72s ease-in-out infinite; }
  @keyframes meridian-turn { 0%, 100% { transform: scaleX(0); } 25% { transform: scaleX(1); } 50% { transform: scaleX(0); } 75% { transform: scaleX(-1); } }

  .fig { position: absolute; left: 50%; top: 50%; width: 74%; aspect-ratio: 860 / 852; translate: -50% -50%; transform-style: preserve-3d;
    transform: rotateY(calc(var(--px) * 16deg)) rotateX(calc(var(--py) * -10deg)); transition: transform .35s ease-out;
    animation: yaw 14s ease-in-out infinite alternate; }
  .layer { position: absolute; inset: 0; width: 100%; height: 100%; user-select: none; pointer-events: none; }
  .l-glow { filter: blur(22px) brightness(1.5); opacity: .55; transform: translateZ(-70px) scale(1.06); }
  .l-back { filter: brightness(.55) saturate(.7); opacity: .7; transform: translateZ(-34px); }
  .l-main { transform: translateZ(0); filter: drop-shadow(0 0 1px #fff) drop-shadow(0 18px 24px rgba(0,0,0,.45)); }
  .l-front { opacity: .35; mix-blend-mode: screen; transform: translateZ(30px) scale(1.012); }
  @keyframes yaw { from { rotate: y -12deg; } to { rotate: y 12deg; } }

  @media (prefers-reduced-motion: reduce) {
    .meridian { animation: none; transform: scaleX(.6); }
    .fig { animation: none; transition: none; }
  }
</style>
