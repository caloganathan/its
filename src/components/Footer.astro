---
import { SITE, type Lang } from '../site';
import { nav, useT } from '../i18n/ui';
import Kolam from './Kolam.astro';
import Seal from './Seal.astro';
import { BUILD } from '../build';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
---
<footer class="site-footer">
  <Kolam class="footer-kolam" />
  <div class="shell">
    <div class="grid">
      <div class="about">
        <a class="f-brand" href={`/${lang}/`}><Seal size={84} alt={`${SITE.name} logo`} /></a>
        <p class="f-name">Indonesia Tamil Sangam<span lang="ta">{SITE.nameTa}</span></p>
        <p class="muted">{t('footer.about')}</p>
        {SITE.social.length > 0 && <ul class="social">{SITE.social.map((s) => <li><a href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>)}</ul>}
      </div>
      <div>
        <h2 class="f-h">{t('footer.explore')}</h2>
        <ul class="links">{nav.map((n) => <li><a href={`/${lang}/${n.href}`}>{t(`nav.${n.id}`)}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="f-h">{t('contact.heading')}</h2>
        <ul class="links contact">
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={`tel:${SITE.phoneE164}`}>{SITE.phoneDisplay}</a></li>
          <li class="muted">{SITE.address.short}, Indonesia</li>
        </ul>
        <a class="btn" href={`/${lang}/join/`}>{t('nav.join')} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="base">
      <span>© {new Date().getFullYear()} {SITE.name}. {t('footer.rights')} <span class="legal">{t('footer.registered')}: {SITE.legalName}</span>
      <span class="legal build">Build {BUILD.sha} · {BUILD.date.slice(0, 10)}</span></span>
      <span><a href={`/${lang}/privacy/`}>{t('footer.privacy')}</a> · <a href={`/${lang}/media/`}>{t('footer.media')}</a></span>
    </div>
  </div>
</footer>
<style>
  .site-footer { position: relative; overflow: hidden; background: var(--ink); color: var(--on-dark-muted); padding: clamp(4rem, 8vw, 6rem) 0 2rem; isolation: isolate; }
  .site-footer :global(.footer-kolam) { position: absolute; width: 520px; left: -160px; bottom: -200px; opacity: .08; z-index: -1; }
  .grid { display: grid; grid-template-columns: 1.4fr 1fr 1.2fr; gap: 3rem; }
  .f-brand { display: inline-block; margin-bottom: 1.25rem; }
  .f-name { font-family: var(--f-display); font-size: 1.4rem; color: #fff; line-height: 1.3; }
  .f-name span { display: block; font-family: 'Noto Serif Tamil Variable', serif; font-size: .95rem; color: var(--gold-2); }
  .muted { color: var(--on-dark-muted); max-width: 38ch; }
  .f-h { font-family: var(--f-body); font-size: .74rem; letter-spacing: .22em; text-transform: uppercase; color: var(--gold-2); font-weight: 650; margin-bottom: 1.2rem; }
  :lang(ta) .f-h { letter-spacing: .04em; font-size: .85rem; }
  .links { list-style: none; padding: 0; margin: 0 0 1.5rem; display: grid; gap: .55rem; }
  .links a { color: #fff; text-decoration: none; opacity: .85; }
  .links a:hover { opacity: 1; color: var(--gold-2); }
  .contact a { word-break: break-word; }
  .social { list-style: none; padding: 0; display: flex; gap: 1rem; }
  .social a { color: var(--gold-2); }
  .base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,.1); font-size: .82rem; }
  .base a { color: #fff; }
  .legal { display: block; opacity: .7; margin-top: .25rem; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .grid { grid-template-columns: 1fr; } }
</style>
