---
// The logo carries its own white interior, so it is legible on light and dark grounds without a medallion.
import { SITE } from '../site';
const { size = 56, alt = '', priority = false, class: cls = '' } = Astro.props;
---
<span class:list={['seal', cls]} style={`--s:${size}px`}>
  <img src={SITE.logo} alt={alt} width="1022" height="990" decoding="async" fetchpriority={priority ? 'high' : undefined} loading={priority ? 'eager' : 'lazy'} />
</span>
<style>
  .seal { display: inline-grid; place-items: center; width: var(--s); flex-shrink: 0; filter: drop-shadow(0 calc(var(--s) * .08) calc(var(--s) * .16) rgba(0,0,0,.35)); transition: width .5s var(--ease); }
  .seal img { width: 100%; height: auto; display: block; }
</style>
